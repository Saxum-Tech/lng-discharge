NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SYNC_CRON_TOKEN=replace-with-strong-random-token
# Optional Vercel alias; route accepts either SYNC_CRON_TOKEN or CRON_SECRET.
# CRON_SECRET=replace-with-strong-random-token
GIBRALTAR_CRUISE_SCHEDULE_URL=https://www.gibraltarport.com/shipping/cruise-schedule
GIBRALTAR_AIRPORT_FLIGHTS_URL=https://www.gibraltarairport.gi/flight-information
# Optional override. If unset, the sync uses AviationStack when aviation_api_key is set in app settings.
# FREE_FLIGHT_API_URL=http://api.aviationstack.com/v1/flights?access_key=YOUR_KEY&arr_iata=GIB
